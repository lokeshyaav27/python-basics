# Database Configuration
DATABASE_URL=postgresql://postgres:admin@localhost:5432/dsa-mgmt
ENVIRONMENT=development

# Storage Directories
STORAGE_BASE_DIR=dsa-file-storage
STORAGE_PRODUCT_IMAGES_DIR=product-images
STORAGE_BANK_LOGOS_DIR=bank-logo-images
STORAGE_AGENT_PHOTOS_DIR=agent-photos
STORAGE_BANK_DOCS_DIR=bank-documents

# AI Provider Configuration (Manual Switch: 'false' for Groq, 'true' for local Ollama)
USE_OLLAMA=false

# Groq Cloud Configuration (Active when USE_OLLAMA=false)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Ollama Local Configuration (Active when USE_OLLAMA=true)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# RAG Vector Search Configuration
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35

# JWT Authentication
JWT_SECRET_KEY=dsa-loan-mgmt-jwt-secret-key-2026-secure-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Model Context Protocol (MCP) Server Configuration
MCP_SERVER_URL=http://localhost:8001/sse
MCP_TRANSPORT=direct
