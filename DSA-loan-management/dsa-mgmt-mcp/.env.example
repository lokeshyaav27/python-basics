# ============================================================================
# DSA Model Context Protocol (MCP) Server Configuration
# ============================================================================

# Server Settings
MCP_SERVER_NAME=dsa-loan-management-mcp
MCP_HOST=0.0.0.0
MCP_PORT=8001
ENVIRONMENT=development

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/dsa-mgmt

# JWT Authentication & RBAC (Matches dsa-mgmt-be)
JWT_SECRET_KEY=dsa-loan-mgmt-jwt-secret-key-2026-secure-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage Directories
STORAGE_BASE_DIR=dsa-file-storage
STORAGE_BANK_DOCS_DIR=bank-documents
FILE_STORAGE_DIR=../dsa-mgmt-be/dsa-file-storage

# RAG Vector Search Configuration
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
